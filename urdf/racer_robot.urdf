<?xml version="1.0"?>
<robot name="racer_robot">

  <!-- ==================== -->
  <!--      BASE LINKS      -->
  <!-- ==================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="chassis"/>
    <!-- Elevado 5cm sobre el suelo -->
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Chassis (Cuerpo principal) -->
  <link name="chassis">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Chasis base -->
        <mesh filename="package://racer_description/meshes/car.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.49 0.18 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.5"/>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <inertia ixx="0.012" ixy="0" ixz="0"
               iyy="0.073" iyz="0" izz="0.078"/>
    </inertial>
  </link>

  <!-- Body (Carroceria visual decorativa) -->
  <joint name="body_joint" type="fixed">
    <parent link="chassis"/>
    <child link="body"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <link name="body">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://racer_description/meshes/body.dae"/>
      </geometry>
    </visual>
  </link>

  <!-- ==================== -->
  <!--     REAR WHEELS      -->
  <!-- ==================== -->

  <!-- Left Rear Wheel -->
  <joint name="left_wheel_back_joint" type="continuous">
    <parent link="chassis"/>
    <child link="left_wheel_back"/>
    <origin xyz="-0.16 0.1055 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="100"/>
  </joint>

  <link name="left_wheel_back">
    <visual>
      <!-- Rueda orientada en el eje Y de la malla -->
      <origin xyz="0 0.02 0" rpy="0 0 3.14159"/>
      <geometry>
        <mesh filename="package://racer_description/meshes/wheel.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.02 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.045"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0.02 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.00016" ixy="0" ixz="0"
               iyy="0.00016" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <!-- Right Rear Wheel -->
  <joint name="right_wheel_back_joint" type="continuous">
    <parent link="chassis"/>
    <child link="right_wheel_back"/>
    <origin xyz="-0.16 -0.1055 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="100"/>
  </joint>

  <link name="right_wheel_back">
    <visual>
      <origin xyz="0 -0.021 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://racer_description/meshes/wheel.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.021 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.045"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 -0.021 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.00016" ixy="0" ixz="0"
               iyy="0.00016" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <!-- ==================== -->
  <!--    STEERING HINGES   -->
  <!-- ==================== -->

  <!-- Left Steering Hinge -->
  <joint name="left_steering_hinge_joint" type="revolute">
    <parent link="chassis"/>
    <child link="left_steering"/>
    <origin xyz="0.16 0.1055 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="10" velocity="100"/>
  </joint>

  <link name="left_steering">
    <inertial>
      <mass value="0.07"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- Right Steering Hinge -->
  <joint name="right_steering_hinge_joint" type="revolute">
    <parent link="chassis"/>
    <child link="right_steering"/>
    <origin xyz="0.16 -0.1055 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="10" velocity="100"/>
  </joint>

  <link name="right_steering">
    <inertial>
      <mass value="0.07"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- ==================== -->
  <!--     FRONT WHEELS     -->
  <!-- ==================== -->

  <!-- Left Front Wheel (Conectado a Hinge Izquierdo) -->
  <joint name="left_wheel_front_joint" type="continuous">
    <parent link="left_steering"/>
    <child link="left_wheel_front"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="left_wheel_front">
    <visual>
      <origin xyz="0 0.02 0" rpy="0 0 3.14159"/>
      <geometry>
        <mesh filename="package://racer_description/meshes/wheel.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.02 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.045"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0.02 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.00016" ixy="0" ixz="0"
               iyy="0.00016" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <!-- Right Front Wheel (Conectado a Hinge Derecho) -->
  <joint name="right_wheel_front_joint" type="continuous">
    <parent link="right_steering"/>
    <child link="right_wheel_front"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_front">
    <visual>
      <origin xyz="0 -0.02 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://racer_description/meshes/wheel.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.02 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.045"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 -0.02 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.00016" ixy="0" ixz="0"
               iyy="0.00016" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <!-- ==================== -->
  <!--      LIDAR LINK      -->
  <!-- ==================== -->
  <joint name="lidar_joint" type="fixed">
    <parent link="chassis"/>
    <child link="lidar_link"/>
    <!-- Parachoques delantero -->
    <origin xyz="0.21 0 0.135" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://racer_description/meshes/hokuyo.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ==================== -->
  <!--     CAMERA LINK      -->
  <!-- ==================== -->
  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <!-- Camara baja a 9.5cm, adelantada 21cm, inclinacion de 5 grados hacia abajo -->
    <origin xyz="0.21 0 0.095" rpy="0 0.08 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://racer_description/meshes/ZED.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00005" ixy="0" ixz="0"
               iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- Optical frame convention ROS -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="camera_link_optical"/>

  <!-- ==================== -->
  <!--    GAZEBO PLUGINS    -->
  <!-- ==================== -->

  <!-- Ackermann Steering Plugin -->
  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>left_wheel_back_joint</left_joint>
      <right_joint>right_wheel_back_joint</right_joint>
      <left_steering_joint>left_steering_hinge_joint</left_steering_joint>
      <right_steering_joint>right_steering_hinge_joint</right_steering_joint>
      <kingpin_width>0.211</kingpin_width>
      <wheelbase>0.32</wheelbase>
      <wheel_radius>0.05</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

  <!-- Joint State Publisher -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_wheel_back_joint</joint_name>
      <joint_name>right_wheel_back_joint</joint_name>
      <joint_name>left_steering_hinge_joint</joint_name>
      <joint_name>right_steering_hinge_joint</joint_name>
      <joint_name>left_wheel_front_joint</joint_name>
      <joint_name>right_wheel_front_joint</joint_name>
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- GPU Lidar Sensor -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <!-- Camera Sensor -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>camera/image_raw</topic>
      <gz_frame_id>camera_link_optical</gz_frame_id>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

</robot>
