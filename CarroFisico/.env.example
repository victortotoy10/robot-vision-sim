# =====================================================================
# CONFIGURACIÓN DE RED Y ROBOT - CarroFisico
# Copia este archivo a .env y ajusta tus credenciales
# =====================================================================

# Hotspot directo desde Laptop
LAPTOP_HOTSPOT_SSID=LAPTOP_ROBOT
LAPTOP_HOTSPOT_PASS=12345678

# Red Wi-Fi de Router local (opcional)
ROUTER_WIFI_SSID=TU_RED_WIFI
ROUTER_WIFI_PASS=TU_PASSWORD_WIFI

# Configuración IP Estática (Subred de Zona con cobertura de Windows)
GATEWAY_IP=192.168.137.1
NETMASK=255.255.255.0
ESP32_MOTOR_IP=192.168.137.47
ESP32_CAM_IP=192.168.137.48

