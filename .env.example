# =====================================================================
# CONFIGURACIÓN DE RED Y ROBOT - robot-vision-sim
# Archivo de ejemplo: copia este archivo a .env y completa tus datos
# NUNCA subas tu archivo .env real al repositorio de Git
# =====================================================================

# 1. Hotspot de Laptop (Zona con cobertura inalámbrica móvil de Windows)
# Recomendado: Configurado en banda 2.4 GHz y con 'Ahorro de energía' desactivado
LAPTOP_HOTSPOT_SSID=LAPTOP_ROBOT
LAPTOP_HOTSPOT_PASS=12345678

# 2. Red Wi-Fi Local Alternativa (Router de casa / laboratorio)
ROUTER_WIFI_SSID=TU_RED_WIFI
ROUTER_WIFI_PASS=TU_PASSWORD_WIFI

# 3. Direcciones IP Estáticas asignadas a los microcontroladores (Subred 192.168.137.x)
GATEWAY_IP=192.168.137.1
NETMASK=255.255.255.0
ESP32_MOTOR_IP=192.168.137.47
ESP32_CAM_IP=192.168.137.48

# 4. Puertos de Servicios del Robot
MOTOR_HTTP_PORT=80
CAM_HTTP_PORT=80
CAM_STREAM_PORT=81

